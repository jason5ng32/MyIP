{
  "name": "myip",
  "private": true,
  "version": "8.2.0",
  "license": "AGPL-3.0-only",
  "type": "module",
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=26.0.0"
  },
  "scripts": {
    "dev": "concurrently \"vite\" \"nodemon --env-file-if-exists=.env --import ./sentry-instrument.js backend-server.js\"",
    "build": "vite build",
    "postbuild": "node -e \"const{existsSync}=require('fs');const{spawnSync}=require('child_process');if(existsSync('scripts/purge-index-cache.js')){const r=spawnSync(process.execPath,['--env-file-if-exists=.env','scripts/purge-index-cache.js'],{stdio:'inherit'});process.exit(r.status??1)}\"",
    "test": "node --import ./tests/setup.js --test tests/*.test.js",
    "check": "pnpm run test && pnpm run build",
    "preview": "vite preview",
    "start-backend": "node --env-file-if-exists=.env --import ./sentry-instrument.js backend-server.js",
    "start-frontend": "node --env-file-if-exists=.env frontend-server.js",
    "start": "concurrently \"node --env-file-if-exists=.env frontend-server.js\" \"node --env-file-if-exists=.env --import ./sentry-instrument.js backend-server.js\"",
    "purge-index": "node --env-file-if-exists=.env scripts/purge-index-cache.js",
    "dns-check": "node scripts/check-dns-resolvers.js",
    "fetch-favicons": "node scripts/fetch-favicons.js",
    "i18n-status": "node scripts/i18n-status.js",
    "i18n-new": "node scripts/i18n-scaffold.js new",
    "i18n-sync": "node scripts/i18n-scaffold.js sync"
  },
  "dependencies": {
    "@cloudflare/speedtest": "^1.17.0",
    "@iconify-json/circle-flags": "^1.2.14",
    "@iconify/vue": "^5.0.5",
    "@khmyznikov/pwa-install": "^0.7.0",
    "@lucide/vue": "^1.70.0",
    "@photostructure/tz-lookup": "^11.8.0",
    "@sentry/node": "^11.11.0",
    "@sentry/vue": "^11.11.0",
    "@tanstack/vue-table": "^9.3.1",
    "@thumbmarkjs/thumbmarkjs": "^1.12.0",
    "@vueuse/core": "^15.0.0",
    "chart.js": "^4.6.1",
    "chartjs-chart-geo": "^4.3.6",
    "circle-progress.vue": "^3.4.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "concurrently": "^10.0.7",
    "croner": "^11.0.0",
    "dagre": "^0.8.5",
    "express": "^5.3.0",
    "firebase": "^13.2.0",
    "html-to-image": "^1.11.13",
    "http-proxy-middleware": "^4.2.1",
    "maxmind": "^5.0.8",
    "pinia": "^4.1.0",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "pino-pretty": "^13.2.0",
    "proper-lockfile": "^4.1.2",
    "reka-ui": "^2.11.0",
    "tailwind-merge": "^3.7.0",
    "tar": "^7.5.22",
    "tw-animate-css": "^1.4.0",
    "ua-parser-js": "^2.0.10",
    "unbzip2-stream": "^1.4.3",
    "vaul-vue": "^0.4.1",
    "vue": "^3.5.45",
    "vue-i18n": "^11.4.18",
    "vue-input-otp": "^0.4.0",
    "vue-markdown-render": "^3.0.0",
    "vue-router": "^5.4.0",
    "vue-sonner": "^2.0.9",
    "whoiser": "^1.18.0",
    "world-atlas": "^2.0.2",
    "write-file-atomic": "^8.0.0"
  },
  "devDependencies": {
    "@sentry/vite-plugin": "^11.11.0",
    "@tailwindcss/vite": "^4.3.5",
    "@vitejs/plugin-vue": "^6.0.10",
    "code-inspector-plugin": "^2.0.9",
    "nodemon": "^3.1.14",
    "tailwindcss": "^4.3.5",
    "vconsole": "^3.15.1",
    "vite": "^8.3.7"
  }
}
